<?xml version="1.0" encoding="UTF-8"?>

<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
<include>QStandardPaths</include>
<include>CaptureModeModel.h</include>
<include>Platforms/VideoPlatform.h</include>
<include>Gui/SettingsDialog/SettingsUtils.h</include>
<include>KLocalizedString</include>
<kcfgfile name="ectolensrc" />
<group name="General">
    <entry name="launchAction" type="Enum">
        <label>What to do when Spectacle is launched</label>
        <choices>
        <choice name="TakeRectangularScreenshot"></choice>
        <choice name="TakeFullscreenScreenshot"></choice>
        <choice name="UseLastUsedCapturemode"></choice>
        <choice name="DoNotTakeScreenshot"></choice>
        </choices>
        <default>TakeRectangularScreenshot</default>
    </entry>
    <entry name="printKeyRunningAction" type="Enum">
        <label>What should happen if print key is pressed when Spectacle is already running</label>
        <choices>
        <choice name="TakeNewScreenshot"></choice>
        <choice name="StartNewInstance"></choice>
        <choice name="FocusWindow"></choice>
        </choices>
        <default>TakeNewScreenshot</default>
    </entry>
    <entry name="autoSaveImage" type="Bool">
        <label>Save screenshot automatically after it is taken</label>
        <default>false</default>
    </entry>
    <entry name="closeAfterOcr" type="Bool">
        <label>Close after extraction (skips auto-save)</label>
        <default>false</default>
    </entry>
    <!-- Ectolens: After Capture, the list behind Capture's arrow (design proposal 2).
         Every row is a check, so they stack; a choice at the end of a row says how.
         Save to file is autoSaveImage above. Copy only is the default. -->
    <entry name="afterCaptureOpen" type="Bool">
        <label>Open the capture in an app</label>
        <default>false</default>
    </entry>
    <entry name="afterCaptureOpenApp" type="String">
        <label>The app to open captures in; empty means the Ectolens window</label>
        <default></default>
    </entry>
    <entry name="afterCaptureSaveWhere" type="Enum">
        <label>Where Save to file puts a capture: the Screenshots folder, or ask each time</label>
        <choices>
        <choice name="SaveToScreenshots"></choice>
        <choice name="AskWhereEachTime"></choice>
        </choices>
        <default>SaveToScreenshots</default>
    </entry>
    <entry name="afterCaptureShowInFolder" type="Bool">
        <label>Show the saved file in its folder</label>
        <default>false</default>
    </entry>
    <entry name="afterCaptureCopy" type="Bool">
        <label>Copy to the clipboard</label>
        <default>true</default>
    </entry>
    <entry name="afterCaptureCopyWhat" type="Enum">
        <label>What to copy: the image, or the saved file's path</label>
        <choices>
        <choice name="CopyTheImage"></choice>
        <choice name="CopyTheFilePath"></choice>
        </choices>
        <default>CopyTheImage</default>
    </entry>
    <entry name="afterCaptureShare" type="Bool">
        <label>Share the capture</label>
        <default>false</default>
    </entry>
    <entry name="afterCaptureShareTarget" type="String">
        <label>The share service to use; empty means ask each time</label>
        <default></default>
    </entry>
    <entry name="resizeWindowToFit" type="Bool">
        <label>Resize a window to the size picked in the frame label's menu</label>
        <default>true</default>
    </entry>
    <entry name="agentAccess" type="Bool">
        <label>Let AI agents ask for captures and recordings through Ectolens's MCP server; each one waits for the person to send it</label>
        <default>false</default>
    </entry>
    <entry name="agentHidePrivateInfo" type="Bool">
        <label>Blur private information (Hide Private Info) on every capture an agent asks for, before the person sends it</label>
        <default>true</default>
    </entry>
    <entry name="revertSizeAfterward" type="Bool">
        <label>Put a resized window back to its old size after the capture or recording</label>
        <default>true</default>
    </entry>
    <entry name="useLightMaskColor" type="Bool">
        <label>Whether to use a light color mask in the region selection dialog</label>
        <default>false</default>
    </entry>
    <entry name="showMagnifier" type="Enum">
        <label>Clipboard action which should be executed after the screenshot is taken</label>
        <choices>
        <choice name="ShowMagnifierNever"></choice>
        <choice name="ShowMagnifierAlways"></choice>
        <choice name="ShowMagnifierShiftHeld"></choice>
        </choices>
        <default>ShowMagnifierShiftHeld</default>
    </entry>
    <entry name="useReleaseToCapture" type="Bool">
        <label>Whether the screenshot should be captured after selecting the region and releasing the mouse</label>
        <default>false</default>
    </entry>
    <entry name="rememberSelectionRect" type="Enum">
        <label>Remember the last rectangular region</label>
        <choices>
        <choice name="Never"></choice>
        <choice name="Always"></choice>
        <choice name="UntilClosed"></choice>
        </choices>
        <default>UntilClosed</default>
    </entry>
    <entry name="ocrLanguages" type="StringList">
        <label>Default languages for OCR text recognition</label>
        <default>eng</default>
    </entry>
</group>
<group name="GuiConfig">
    <entry name="selectionRect" type="RectF">
        <label>The last used region the user selected</label>
        <default>QRectF(0,0,0,0)</default>
    </entry>
    <entry name="captureOnClick" type="Bool">
        <label>Take screenshot on click</label>
        <default>false</default>
    </entry>
    <entry name="includePointer" type="Bool">
        <label>Whether the mouse cursor is included in the screenshot</label>
        <default>false</default>
    </entry>
    <entry name="videoIncludePointer" type="Bool">
        <label>Whether the mouse cursor is included in the video</label>
        <default>true</default>
    </entry>
    <entry name="videoRecordSystemAudio" type="Bool">
        <label>Whether system audio is included in the recording</label>
        <default>false</default>
    </entry>
    <entry name="videoRecordMicrophone" type="Bool">
        <label>Whether microphone audio is included in the recording</label>
        <default>false</default>
    </entry>
    <entry name="videoSeparateAudioTracks" type="Bool">
        <label>With system audio and the microphone both recorded, whether each also gets a track of its own, after a track that mixes them</label>
        <default>false</default>
    </entry>
    <entry name="videoQuality" type="Enum">
        <label>Recording quality: Small, High, Best or Custom</label>
        <choices>
            <choice name="Small"></choice>
            <choice name="High"></choice>
            <choice name="Best"></choice>
            <choice name="Custom"></choice>
        </choices>
        <default>High</default>
    </entry>
    <entry name="videoEncoder" type="String">
        <label>The FFmpeg encoder for recordings (libx264, libx265, libsvtav1, h264_nvenc, hevc_nvenc, av1_nvenc)</label>
        <default>libx264</default>
    </entry>
    <entry name="videoFullRange" type="Bool">
        <label>Record full color range (every shade) instead of the limited range most players expect</label>
        <default>false</default>
    </entry>
    <entry name="videoFramerate" type="UInt">
        <label>Recording frame rate, in frames per second</label>
        <default>60</default>
        <min>1</min>
        <max>1000</max>
    </entry>
    <entry name="videoQualityLevel" type="Double">
        <label>Custom quality level in the encoder's own scale (x264: crf); lower is sharper</label>
        <default>16</default>
        <min>0</min>
        <max>63</max>
    </entry>
    <entry name="videoSpeedPreset" type="String">
        <label>Custom encoder speed preset (x264: ultrafast to placebo)</label>
        <default>veryfast</default>
    </entry>
    <entry name="videoKeyframeSeconds" type="Double">
        <label>Custom seconds between keyframes</label>
        <default>2</default>
        <min>0.1</min>
        <max>60</max>
    </entry>
    <entry name="videoBFrames" type="Int">
        <label>Custom number of B-frames; -1 lets the speed preset decide</label>
        <default>-1</default>
        <min>-1</min>
        <max>16</max>
    </entry>
    <entry name="videoFullColor" type="Bool">
        <label>Custom: record full color detail (4:4:4)</label>
        <default>false</default>
    </entry>
    <entry name="videoExtraOptions" type="String">
        <label>Custom extra encoder options (x264: key=value:key=value)</label>
        <default></default>
    </entry>
    <entry name="includeDecorations" type="Bool">
        <label>Whether the window decorations are included in the screenshot</label>
        <default>true</default>
    </entry>
    <entry name="includeShadow" type="Bool">
        <label>Whether the window shadow is included in the screenshot</label>
        <default>true</default>
    </entry>
    <entry name="quitAfterSaveCopyExport" type="Bool">
        <label>Quit after saving or copying an image</label>
        <default>false</default>
    </entry>
    <entry name="captureDelay" type="Double">
        <label>Delay</label>
        <default>0</default>
        <min>0</min>
    </entry>
    <entry name="captureMode" type="Enum">
        <choices name="CaptureModeModel::CaptureMode"></choices>
        <default>CaptureModeModel::CaptureMode::AllScreens</default>
    </entry>
</group>
<group name="Appearance">
    <!-- Ectolens: Settings > Appearance (design proposal 2). -->
    <entry name="look" type="Enum">
        <label>The look of the overlay and the window</label>
        <choices>
        <choice name="EctoLook"></choice>
        <choice name="KdeLook"></choice>
        </choices>
        <default>EctoLook</default>
    </entry>
    <entry name="accent" type="Enum">
        <label>The color that marks where you are</label>
        <choices>
        <choice name="EctoGreenAccent"></choice>
        <choice name="KdeAccent"></choice>
        <choice name="CustomAccent"></choice>
        </choices>
        <default>EctoGreenAccent</default>
    </entry>
    <entry name="customAccentColor" type="Color">
        <label>The accent color you picked</label>
        <default>#38bdf8</default>
    </entry>
    <entry name="dimAmount" type="UInt">
        <label>How dark the rest of the screen gets, in percent</label>
        <default>40</default>
        <min>0</min>
        <max>80</max>
    </entry>
</group>
<group name="ImageSave">
    <entry name="imageSaveLocation" type="Url">
        <label>Default filename</label>
        <code>
            QUrl defaultImageSaveLocation;
            // This is inserted as is, so we enclose it in a scope to prevent name conflicts.
            {
                // We only want to set the translated folder name once so the user doesn't end up
                // with a bunch of different folders when they temporarily change languages.
                auto pictures = QStandardPaths::writableLocation(QStandardPaths::PicturesLocation);
                auto subFolder = onceTranslatedString(Settings::self(), Settings::self()->currentGroup(),
                                                      "translatedScreenshotsFolder",
                                                      i18nc("translatable folder name", "Screenshots"));
                defaultImageSaveLocation = QUrl::fromLocalFile(pictures + u'/' + subFolder + u'/');
            }
        </code>
        <default code="true">defaultImageSaveLocation</default>
    </entry>
    <entry name="imageCompressionQuality" type="UInt">
        <label>Compression quality for lossy file formats</label>
        <default>90</default>
        <min>0</min>
        <max>100</max>
    </entry>
    <entry name="preferredImageFormat" type="String">
        <!--This is a string because the available formats
        come from QImageWriter::supportedImageFormats()-->
        <label>Default save image format</label>
        <default>PNG</default>
    </entry>
    <entry name="imageFilenameTemplate" type="String">
        <label>The filename template used when saving screenshots</label>
        <default code="true">
            i18nc("part of default image filename template", "Screenshot")
            + u"_&lt;yyyy&gt;&lt;MM&gt;&lt;dd&gt;_&lt;HH&gt;&lt;mm&gt;&lt;ss&gt;"
        </default>
    </entry>
    <entry name="lastImageSaveLocation" type="Url">
        <label>The path of the file saved last</label>
        <default code="true">imageSaveLocation()</default>
    </entry>
    <entry name="lastImageSaveAsLocation" type="Url">
        <label>Last path used for "save as" action</label>
        <default code="true">imageSaveLocation()</default>
    </entry>
</group>
<group name="VideoSave">
    <entry name="videoSaveLocation" type="Url">
        <label>Default filename</label>
        <code>
            QUrl defaultVideoSaveLocation;
            // This is inserted as is, so we enclose it in a scope to prevent name conflicts.
            {
                // We only want to set the translated folder name once so the user doesn't end up
                // with a bunch of different folders when they temporarily change languages.
                auto videos = QStandardPaths::writableLocation(QStandardPaths::MoviesLocation);
                auto subFolder = onceTranslatedString(Settings::self(), Settings::self()->currentGroup(),
                                                      "translatedScreencastsFolder",
                                                      i18nc("translatable folder name", "Screencasts"));
                defaultVideoSaveLocation = QUrl::fromLocalFile(videos + u'/' + subFolder + u'/');
            }
        </code>
        <default code="true">defaultVideoSaveLocation</default>
    </entry>
    <entry name="preferredVideoFormat" type="Enum">
        <label>Default video format</label>
        <choices name="VideoPlatform::Format"></choices>
        <default>VideoPlatform::Format::DefaultFormat</default>
    </entry>
    <entry name="videoFilenameTemplate" type="String">
        <label>The filename template used when saving screencasts</label>
        <default code="true">
            i18nc("part of default video filename template", "Screencast")
            + u"_&lt;yyyy&gt;&lt;MM&gt;&lt;dd&gt;_&lt;HH&gt;&lt;mm&gt;&lt;ss&gt;"
        </default>
    </entry>
    <entry name="lastVideoSaveLocation" type="Url">
        <label>The path of the file saved last</label>
        <default code="true">videoSaveLocation()</default>
    </entry>
    <entry name="lastVideoSaveAsLocation" type="Url">
        <label>Last path used for "save as" action</label>
        <default code="true">videoSaveLocation()</default>
    </entry>
</group>
</kcfg>
